<!--
    Operation policy for handleSelfcareWebhook.
    The x-api-key is validated natively by APIM (subscription_required on the API);
    here we only validate the SelfCare JWT token.
-->
<policies>
  <inbound>
    <base />
    <include-fragment fragment-id="${jwt_fragment_id}" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
