<!--
    Base policy for RTP Service Providers API.
    Provides backend retry and common configuration across all operations in this specification.
-->
<policies>
  <inbound>
    <base />
  </inbound>
  <backend>
    <include-fragment fragment-id="${backend_fragment_id}" />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
